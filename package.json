{
  "name": "game2",
  "version": "0.1.0",
  "private": true,
  "description": "Scandinavian Flick — a drift-first arcade rally game for the browser: 3D low-poly stages, generated by a rules engine, playable on phone and desktop as an installable PWA.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Niclas Lindstedt <niclas@agilator.se>",
  "type": "module",
  "workspaces": [
    "pwa"
  ],
  "overrides": {
    "react": "npm:@preact/compat@^18.3.2",
    "react-dom": "npm:@preact/compat@^18.3.2"
  },
  "scripts": {
    "dev": "npm run dev --workspace pwa",
    "build": "npm run typecheck:only && npm run build --workspace pwa",
    "preview": "npm run preview --workspace pwa",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck:only",
    "typecheck:only": "tsc --noEmit && npm run typecheck --workspace pwa",
    "lint": "eslint . && npm run typecheck:only",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "sim": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/simulate-run.mjs",
    "tape": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/run-tape.mjs",
    "track": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/track-preview.mjs",
    "level": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/level-map.mjs",
    "routes": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/stage-routes.mjs",
    "biomes": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/biome-preview.mjs",
    "analyze": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/analyze-stage.mjs",
    "drift": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/drift-lab.mjs",
    "roll": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/roll-lab.mjs",
    "crash": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/crash-lab.mjs",
    "verge": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verge-lab.mjs",
    "cars": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/car-preview.mjs",
    "items": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/item-preview.mjs",
    "sky": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/sky-preview.mjs",
    "traffic": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/traffic-preview.mjs",
    "glyphs": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/glyph-preview.mjs",
    "health": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/health-preview.mjs",
    "transit": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/transit-preview.mjs",
    "rollcam": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/roll-cam.mjs",
    "views": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/views-preview.mjs",
    "audition": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/audition.mjs",
    "profile": "node scripts/profile-render.mjs",
    "tauri": "npm --prefix tauri run start --",
    "tauri:bundle": "npm --prefix tauri run bundle",
    "tauri:test": "npm --prefix tauri test",
    "tauri:lint": "npm --prefix tauri run lint",
    "tauri:fmt": "npm --prefix tauri run fmt",
    "tauri:install": "npm --prefix tauri install",
    "tauri:package": "npm run tauri:install && npm --prefix tauri run package --",
    "native": "npm --prefix native start",
    "native:install": "npm --prefix native install",
    "native:bundle": "npm --prefix native run bundle",
    "native:typecheck": "npm --prefix native run typecheck",
    "native:ios": "npm --prefix native run ios",
    "native:ios:device": "npm --prefix native run ios:device",
    "native:android": "npm --prefix native run android"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
