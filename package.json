{
  "name": "game2",
  "version": "0.1.0",
  "private": true,
  "description": "Scandinavian Flick — a drift-first arcade rally game for the browser: 3D low-poly stages, generated by a rules engine, playable on phone and desktop as an installable PWA.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Niclas Lindstedt <niclas@agilator.se>",
  "type": "module",
  "workspaces": [
    "pwa"
  ],
  "overrides": {
    "react": "npm:@preact/compat@^18.3.2",
    "react-dom": "npm:@preact/compat@^18.3.2"
  },
  "scripts": {
    "dev": "npm run dev --workspace pwa",
    "build": "npm run typecheck:only && npm run build --workspace pwa",
    "preview": "npm run preview --workspace pwa",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck:only",
    "typecheck:only": "tsc --noEmit && npm run typecheck --workspace pwa",
    "lint": "eslint . && npm run typecheck:only",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "sim": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/simulate-run.mjs",
    "track": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/track-preview.mjs",
    "cars": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/car-preview.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
