#!/usr/bin/env bash
# Pre-commit hook (OSS_SPEC §16). Install once with `make hooks`.
#
# Fast checks only: formatting and the CHANGELOG guard. The full lint and
# test suite stay in CI — a hook that takes a minute gets bypassed, and a
# bypassed hook protects nothing.
set -euo pipefail

# Formatting — the same check CI runs first.
npm run fmt:check || {
  echo ""
  echo "pre-commit: formatting check failed — run 'make fmt' and re-stage."
  exit 1
}

# CHANGELOG.md is machine-written by the release workflow from the
# .changes/unreleased/ fragments; hand edits get overwritten and break the
# collation. Releases commit with a chore(release) subject — that path is
# allowed through by matching the staged commit's intent via env override.
if git diff --cached --name-only | grep -qx "CHANGELOG.md"; then
  if [ "${ALLOW_CHANGELOG_EDIT:-}" != "1" ]; then
    echo ""
    echo "pre-commit: CHANGELOG.md is generated by the release workflow."
    echo "Drop a fragment in .changes/unreleased/ instead (see CONTRIBUTING.md)."
    echo "A release commit may bypass with ALLOW_CHANGELOG_EDIT=1."
    exit 1
  fi
fi

# Trailing whitespace fixer for staged text files.
files=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '\.(ts|tsx|js|mjs|css|md|yml|yaml|json|sh)$' || true)
if [ -n "$files" ]; then
  # shellcheck disable=SC2086
  if grep -nE ' +$' $files >/dev/null 2>&1; then
    echo "pre-commit: trailing whitespace in staged files:"
    # shellcheck disable=SC2086
    grep -lE ' +$' $files | sed 's/^/  /'
    echo "Fix (e.g. 'make fmt') and re-stage."
    exit 1
  fi
fi
