{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "24.21.0",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "node": "24.21.0",
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "testflight": {
      "node": "24.21.0",
      "autoIncrement": true
    },
    "production": {
      "node": "24.21.0",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascApiKeyPath": "$ASC_KEY_PATH",
        "ascApiKeyId": "$ASC_KEY_ID",
        "ascApiKeyIssuerId": "$ASC_ISSUER_ID"
      },
      "android": {
        "serviceAccountKeyPath": "$PLAY_SERVICE_ACCOUNT_PATH",
        "track": "internal"
      }
    }
  }
}
