{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scandinavian Flick",
  "mainBinaryName": "scanflick",
  "version": "0.1.0",
  "identifier": "se.agilator.scanflick",
  "build": {
    "frontendDist": "./placeholder"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "app", "dmg", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/512x512.png"],
    "resources": {
      "../webroot": "webroot"
    },
    "externalBin": [],
    "category": "Game",
    "shortDescription": "A drift-first arcade rally game",
    "longDescription": "A drift-first arcade rally game that runs in your browser. Low-poly 3D stages generated fresh every day — hairpins, jumps, fords — playable on your phone or desktop, offline once loaded. No account, no download.",
    "copyright": "Copyright © Niclas Lindstedt",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
